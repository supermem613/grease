{
  "version": 1,
  "updated": "2026-07-16",
  "owner": "Marcus Markiewicz",
  "note": "Classification policy read during /grease-triage. Maps a Grease friction item to a backlog queue by its captured tool and source. Applied top-down; first match wins. All `regex` values are matched case-insensitively (JS flag \"i\"). This file is the routing POLICY only. The queue-to-directory BINDINGS live in ~/.backlog/backlog.db (managed by the backlog extension; inspect with `backlog queue list`). To place an item, resolve the queue here, then `backlog add \"<desc>\" --cwd <queueDir>`.",
  "regexFlags": "i",
  "routingModel": "Backlog resolves a queue from the session cwd (exact > worktree-origin > ancestor). Product repos with their own directory (atrium, uatu/eidos, soda, uhura, etc.) auto-route when work happens there. Built-in-tool and skill/agent friction is captured while cwd is a VICTIM repo, so cwd cannot classify it; those are routed EXPLICITLY by the triager using the captured tool/source and this map, adding via `--cwd <queueDir>` against a dedicated anchor.",
  "queueDirs": {
    "atrium": "C:/Users/marcusm/repos/atrium",
    "uatu": "C:/Users/marcusm/repos/uatu",
    "soda": "C:/Users/marcusm/repos/soda",
    "grease": "C:/Users/marcusm/repos/grease",
    "kb": "C:/Users/marcusm/repos/kb",
    "reflux": "C:/Users/marcusm/repos/reflux",
    "rotunda": "C:/Users/marcusm/repos/rotunda",
    "winch": "C:/Users/marcusm/repos/winch",
    "xray": "C:/Users/marcusm/repos/xray",
    "backlog": "C:/Users/marcusm/repos/backlog",
    "uhura": "C:/Users/marcusm/repos/uhura",
    "copilot-skills": "C:/Users/marcusm/.copilot/skills",
    "copilot-cli": "C:/Users/marcusm/.copilot/backlog-anchors/copilot-cli"
  },
  "rules": [
    { "id": "tool-atrium",   "field": "tool",   "regex": "^atrium-",                                                          "queue": "atrium",         "note": "atrium-grep/grep-code/find-files/read/run. Search-primitive rg failures and transport instability live here even though search delegates to xray; disambiguate owner during root-cause." },
    { "id": "tool-uatu",     "field": "tool",   "regex": "^uatu|^por\\.",                                                 "queue": "uatu",           "note": "uatu por.* CLI failures." },
    { "id": "tool-grease",   "field": "tool",   "regex": "^grease_",                                                      "queue": "grease" },
    { "id": "tool-backlog",  "field": "tool",   "regex": "^backlog_",                                                     "queue": "backlog" },
    { "id": "tool-uhura",    "field": "tool",   "regex": "^uhura_",                                                       "queue": "uhura" },
    { "id": "tool-builtin",  "field": "tool",   "regex": "^(edit|create|view|read|glob|grep|read_agent|write_agent|sql|session_store_sql|apply_patch|ask_user|web_fetch|open_canvas|invoke_canvas_action|list_canvas_capabilities|discover_widgets|clear_widget|render_widget|task|powershell|read_powershell|stop_powershell|extensions_manage|tool_search_tool|lsp|get_session|create_session|send_session_message|navigate_to|manage_schedule|list_sessions|respond_to_session_plan)$", "queue": "copilot-cli", "note": "Copilot CLI built-in tools / product. No local repo; items are report/fix-upstream entries." },
    { "id": "tool-skill",    "field": "tool",   "regex": "^skill$",                                                           "queue": "copilot-skills" },
    { "id": "src-atrium",    "field": "source", "regex": "atrium",                                                        "queue": "atrium" },
    { "id": "src-uatu",      "field": "source", "regex": "uatu|por\\.|\\beidos\\b",                                       "queue": "uatu" },
    { "id": "src-uhura",     "field": "source", "regex": "uhura",                                                         "queue": "uhura" },
    { "id": "src-skill",     "field": "source", "regex": "looper|swarm|executor|shadow|chairman|prepar|\\bimplement\\b|\\brelease\\b|\\bconsider\\b|\\brelay\\b|speedify|commit skill|\\bskill\\b|migration gate|readiness|\\bagent|powershell|search.?policy", "queue": "copilot-skills", "note": "Skill and agent definition/workflow and authoring-guidance friction under .copilot/skills, .copilot/agents, and .copilot/hooks. Tool-level builtin errors are caught earlier by tool-builtin; this only catches source-described guidance friction." },
    { "id": "src-grease",    "field": "source", "regex": "grease",                                                        "queue": "grease" },
    { "id": "src-builtin",   "field": "source", "regex": "open_canvas|invoke_canvas|write_agent|read_agent|session_store_sql|apply_patch|deferred MCP tool", "queue": "copilot-cli", "note": "Built-in tool workflow friction named by source rather than by tool field." },
    { "id": "src-xray",      "field": "source", "regex": "\\bxray\\b",                                                    "queue": "xray" },
    { "id": "src-winch",     "field": "source", "regex": "\\bwinch\\b",                                                   "queue": "winch" },
    { "id": "src-reflux",    "field": "source", "regex": "\\breflux\\b",                                                  "queue": "reflux" },
    { "id": "src-rotunda",   "field": "source", "regex": "\\brotunda\\b",                                                 "queue": "rotunda" },
    { "id": "src-kb",        "field": "source", "regex": "\\bkb\\b|inbox-triage",                                         "queue": "kb" },
    { "id": "src-backlog",   "field": "source", "regex": "\\bbacklog\\b|looper-board",                                    "queue": "backlog" },
    { "id": "src-soda",      "field": "source", "regex": "\\bsoda\\b|\\bsd\\b|sidequest",                                  "queue": "soda", "note": "Broad; keep LAST among products. sd is soda's CLI. Skill/agent workflows that merely mention sd are caught earlier by src-skill." }
  ],
  "fallback": "No rule matched: HALT and ask the user which queue owns it. Do not guess."
}
